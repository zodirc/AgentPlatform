# Agent Platform — 起栈模板
# cp .env.example .env → make up → http://localhost/
# 模型：Web「设置 → 模型」（ADR-019）。高级旋钮：docs/03 附录 A（勿堆回本文件）。

# --- 必填（compose 无默认）---
# 库账号默认 agent/agent/agent；改密码时同步改 DATABASE_URL 与 POSTGRES_*（附录 A）
DATABASE_URL=postgresql://agent:agent@postgres:5432/agent
APP_SECRET_KEY=change-me-in-production
INTERNAL_SERVICE_TOKEN=change-me-internal

# --- 本地友好（生产改口令，并设 APP_ENV=production）---
AUTH_ENABLED=true
ADMIN_PASSWORD=admin
APP_ENV=development
