# Agent Platform — 起栈模板
# cp .env.example .env → make up → http://localhost/
# 模型：Web「设置 → 模型」（热配置）。高级旋钮：docs/core/03 附录 A（勿堆回本文件）。

# --- 必填（compose 无默认）---
# 库账号默认 agent/agent/agent；改密码时同步改 DATABASE_URL 与 POSTGRES_*（附录 A）
DATABASE_URL=postgresql://agent:agent@postgres:5432/agent
APP_SECRET_KEY=change-me-in-production
INTERNAL_SERVICE_TOKEN=change-me-internal

# --- 本地友好（生产改口令，并设 APP_ENV=production）---
AUTH_ENABLED=true
ADMIN_PASSWORD=admin
APP_ENV=development

# --- 发布台（make up/start 默认后台拉起；RELEASE_CONSOLE=0 关闭）---
# RELEASE_CONSOLE_SECRET=change-me-release
# RELEASE_CONSOLE_PORT=9090

# --- Embed / RET-4（make up 时 scripts/resolve_embedding_profile.sh 写入 deploy/embedding.auto.env）---
# EMBEDDING_PROFILE=auto          # auto|small|large；auto=有合适 GPU（VRAM≥8GiB）用 gte-large@1024，否则 gte-small@384
# EMBEDDING_GPU_MIN_MIB=8192      # 「合适 GPU」显存门槛
# EMBEDDING_FORCE_MODEL=          # 高级：强制 HF 模型 id，覆盖 PROFILE
# 生产已退役 MiniLM；勿再把 EMBEDDING_MODEL 设回 all-MiniLM-L6-v2

# --- Official small benches (optional; eval/official) ---
# Data is pulled into BENCH_DATA_DIR (not git). See eval/official/README.md
# BENCH_DATA_DIR=~/.cache/agentplatform-bench
# BENCH_MODEL_API_KEY=
# BENCH_MODEL_NAME=gpt-4o-mini
# BENCH_MODEL_BASE_URL=
# BENCH_API_BASE=http://localhost
# SWE_MAX_WORKERS=1
# Constrained hosts (≤8Gi): keep harness + L1 coding parallel at 1.
# WORKSPACE_AST_INLINE=false
# AST_INDEXER_MEM_LIMIT=768m
# AST_INDEXER_CPUS=1.0
# WORKSPACE_AST_PARSE_CONCURRENCY=1
# SWE_HARNESS_BOARD_TIER=n5          # 部署看板检查 / 预拉默认档
# SWE_HARNESS_CACHE_LEVEL=instance   # 评完保留 instance 镜像（勿用默认 env）
# SWE_HARNESS_REQUIRE_LOCAL_IMAGES=1 # 缺镜像则 fail-fast（避免卡在 Evaluation 0/5）
# 预拉：部署看板「Ops · SWE eval 镜像」或 make official-bench-coding-pull-images
# （约 1GiB/题压缩；不进 git）
