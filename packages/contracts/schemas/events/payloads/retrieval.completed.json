{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/events/payloads/retrieval.completed.json",
  "title": "RetrievalCompletedPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "mode", "hit_count"],
  "properties": {
    "query": { "type": "string", "maxLength": 4096 },
    "mode": {
      "type": "string",
      "enum": ["vector", "keyword", "hybrid", "keyword-fallback", "none"]
    },
    "hit_count": { "type": "integer", "minimum": 0 },
    "excerpt_promote_reorder": {
      "type": "boolean",
      "description": "P10/RET-3: true when _prefer_excerpt_covering_hits changed hit order before return"
    },
    "index": {
      "type": "object",
      "additionalProperties": true
    },
    "summary": { "type": "string", "maxLength": 512 },
    "filters": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "path_prefix": { "type": "string" },
        "applied": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "hits": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "path": { "type": "string" },
          "chunk_id": { "type": "string" },
          "excerpt": { "type": "string", "maxLength": 512 },
          "citation_id": { "type": "string" },
          "score": { "type": "number" }
        }
      }
    },
    "ranked": {
      "type": "array",
      "maxItems": 100,
      "description": "Path+score ranking up to R@100 for Ops / official L1 (no excerpts)",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "path": { "type": "string" },
          "chunk_id": { "type": "string" },
          "score": { "type": "number" }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "description": "HM5 three-stage retrieval audit for Ops (docs/33 HM5, docs/15 §3.3)",
      "properties": {
        "mode": { "type": "string" },
        "rank_method": {
          "type": ["string", "null"],
          "description": "lexical | cross_encoder | none | keyword | …"
        },
        "recall_pool": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/auditHit" }
        },
        "ranked": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/auditHit" }
        },
        "entered_context": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "chunk_id": { "type": "string" },
              "path": { "type": "string" },
              "excerpt": { "type": "string", "maxLength": 512 },
              "citation_id": { "type": "string" },
              "score": { "type": "number" },
              "char_len": { "type": "integer", "minimum": 0 },
              "truncated": { "type": "boolean" }
            }
          }
        },
        "lane_depth": {
          "type": "object",
          "additionalProperties": true,
          "description": "RET-10: per-search lane candidate depths (true counts, not STAGE_CAP preview)",
          "properties": {
            "vector_n": { "type": "integer", "minimum": 0 },
            "bm25_n": { "type": "integer", "minimum": 0 },
            "union_n": { "type": "integer", "minimum": 0 },
            "two_level_doc_n": { "type": "integer", "minimum": 0 },
            "two_level_enabled": { "type": "boolean" },
            "lane_top_k": { "type": "integer", "minimum": 0 },
            "requested_limit": { "type": "integer", "minimum": 0 },
            "over_fetch_multiplier": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "auditHit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "chunk_id": { "type": "string" },
        "path": { "type": "string" },
        "excerpt": { "type": "string", "maxLength": 512 },
        "citation_id": { "type": "string" },
        "score": { "type": "number" },
        "source": { "type": "string" }
      }
    }
  }
}
