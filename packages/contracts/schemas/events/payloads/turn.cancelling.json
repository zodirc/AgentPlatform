{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/events/payloads/turn.cancelling.json",
  "title": "TurnCancellingPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["force"],
  "properties": {
    "force": { "type": "boolean" },
    "cancelled_at_phase": {
      "type": "string",
      "enum": [
        "requested",
        "executor_stopped",
        "tools_cleaned",
        "state_flushed",
        "model_stream",
        "tool_exec",
        "assemble",
        "step_boundary"
      ]
    }
  }
}
