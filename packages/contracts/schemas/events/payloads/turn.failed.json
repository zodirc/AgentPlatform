{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/events/payloads/turn.failed.json",
  "title": "TurnFailedPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["termination_reason"],
  "properties": {
    "termination_reason": {
      "type": "string",
      "enum": [
        "fatal_error",
        "model_timeout",
        "step_timeout",
        "schema_validation_error",
        "approval_resume_timeout",
        "approval_state_lost",
        "budget_exceeded",
        "runner_restart",
        "runner_lost",
        "db_timeout",
        "start_timeout"
      ]
    },
    "message": { "type": "string", "maxLength": 1024 },
    "error_kind": {
      "type": "string",
      "maxLength": 64,
      "description": "壳可直接展示的错误类别，如 auth、network、budget。termination_reason 仍用既有枚举。"
    },
    "post_turn_jobs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "maxItems": 32
    }
  }
}
