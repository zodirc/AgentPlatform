{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/events/payloads/usage.reported.json",
  "title": "UsageReportedPayload",
  "description": "Model API token usage after a step (provider reported when available)",
  "type": "object",
  "additionalProperties": false,
  "required": ["step_index", "input_tokens", "output_tokens"],
  "properties": {
    "step_index": { "type": "integer", "minimum": 0 },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "step_input_tokens": { "type": "integer", "minimum": 0 },
    "step_output_tokens": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "enum": ["provider", "estimated", "mixed"] },
    "retry_count": { "type": "integer", "minimum": 0 },
    "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
    "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
    "cache_hit": { "type": "boolean" },
    "estimated_tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "C3 audit: ContextEngine coarse estimate at assemble (same step)."
    },
    "estimate_to_provider_ratio": {
      "type": "number",
      "minimum": 0,
      "description": "C3 audit: estimated_tokens / provider step_input_tokens (1.0 = perfect)."
    }
  }
}
