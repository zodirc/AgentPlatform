{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/events/payloads/opening.ponds.json",
  "title": "OpeningPondsPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["ponds_id", "items"],
  "properties": {
    "ponds_id": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "maxLength": 4096 },
    "awaiting_choice": {
      "type": "boolean",
      "description": "True when the turn stopped so the user can pick a pond or ask for others."
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 32 },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "who": { "type": "string", "maxLength": 240 },
          "where": { "type": "string", "maxLength": 240 },
          "want": { "type": "string", "maxLength": 240 },
          "chapter_job": { "type": "string", "maxLength": 240 },
          "opening": { "type": "string", "maxLength": 400 },
          "arc": { "type": "string", "maxLength": 400 },
          "flavor": { "type": "string", "maxLength": 400 },
          "price": { "type": "string", "maxLength": 160 },
          "start_kind": {
            "type": "string",
            "enum": [
              "self_notice",
              "pulled_in",
              "granted_path",
              "world_already",
              "no_extraordinary"
            ]
          },
          "promise": {
            "type": "string",
            "enum": [
              "power_steps",
              "costly_truth",
              "survive_relation",
              "dread_decode",
              "social_place"
            ]
          },
          "source_trust": {
            "type": "string",
            "enum": ["trusted", "dubious", "false"]
          },
          "first_conflict_at": {
            "type": "string",
            "enum": ["first_300", "first_1000", "chapter_one", "later"]
          },
          "price_axis": {
            "type": "string",
            "enum": ["lifespan", "memory", "contract", "status", "none"]
          },
          "summary": { "type": "string", "maxLength": 160 }
        }
      }
    }
  }
}
