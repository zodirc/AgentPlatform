{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/events/payloads/step.completed.json",
  "title": "StepCompletedPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_index",
    "outcome"
  ],
  "properties": {
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "label": {
      "type": "string",
      "maxLength": 128
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "cancelled",
        "waiting_approval",
        "waiting_child",
        "failed"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "description": "累计 token。本地接头在断点落盘后附上。",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "subagent_id": {
      "type": "string",
      "minLength": 1,
      "description": "Present when the event originates from a nested delegate sub-agent."
    }
  }
}
