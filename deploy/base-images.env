# Pinned base images for product Dockerfiles (code≠deps cache).
# Hub floating tags (python:3.11-slim, node:20-alpine, …) must NOT invalidate
# the deps layer when only app/** changes.
#
# Bump digests deliberately. `scripts/release/paths.env` lists this file on
# api/runtime/web/ast_indexer — `make up` will mark those modules dirty and
# rebuild (compose ARG change busts deps layers). Force full --no-cache only if
# needed: *_REBUILD_DEPS=1 make up-*   or   make deps-anchor
#
# Override any var at build time (compose build args / env) if you need a newer base.
# GitHub Actions rewrites these to mirror.gcr.io/library/<name>@sha256:… (same digest)
# so a Docker Hub 502 cannot fail `make gate`. Local `make up` still uses Hub.

PYTHON_BASE=python:3.11-slim@sha256:a630a63cdb314e2d138a2fca3e375e319e8568346ffafac5b980f888630ac4f1
NODE_BASE=node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
NGINX_BASE=nginx:alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752
