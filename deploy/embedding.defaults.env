# Committed fallback when resolve-embedding has not run yet.
# make up / start / up-runtime / up-bench regenerate deploy/embedding.auto.env
# (GPU → gte-large@1024, else gte-small@384) which overrides these values.
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=thenlper/gte-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_INDEX_VERSION=9
EMBEDDING_PROFILE_RESOLVED=small
