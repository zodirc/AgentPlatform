# Docker keep-list (gitignore-style allowlist for `make docker-prune-safe`).
# Lines: keep patterns for `repository:tag`. Empty / # comments ignored.
# Globs: * matches any run of non-slash chars in the ref (fnmatch).
#
# KEEP these so make up stays fast (deps anchors + build bases) and product /
# bench / SWE harness remain available. Everything else is a prune candidate.

# Product stack + deps anchors (make up cache)
agent-platform-api:*
agent-platform-runtime:*
agent-platform-web:*
agent-platform-bench:*

# SWE harness eval images
swebench/*
*/swebench/*

# Compose infra
pgvector/pgvector:pg16
caddy:2-alpine

# Build bases (pinned digests / tags used by Dockerfiles)
python:3.11-slim*
node:20-alpine*
nginx:alpine*
docker/dockerfile:*
