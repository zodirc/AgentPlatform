# Local dev: mount source + uvicorn --reload (copy to dev.override.yml; not used in CI).
# Paths are relative to the Compose project directory (= parent of the first -f file,
# i.e. deploy/), so use ../services/... not ../../services/...
# --reload-dir must list both trees: default --reload only watches WORKDIR (/app).
services:
  api:
    volumes:
      - ../services/api/app:/app/app:ro
      - ../packages/contracts/python:/contracts/python:ro
    environment:
      APP_ENV: development
    command:
      [
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "/app/app",
        "--reload-dir",
        "/contracts/python",
      ]
  runtime:
    volumes:
      - ../services/runtime/app:/app/app:ro
      - ../packages/contracts/python:/contracts/python:ro
      - ../packages/contracts/plan_suggest:/app/packages/contracts/plan_suggest:ro
    environment:
      APP_ENV: development
    command:
      [
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8001",
        "--reload",
        "--reload-dir",
        "/app/app",
        "--reload-dir",
        "/app/packages/contracts",
        "--reload-dir",
        "/contracts/python",
      ]
