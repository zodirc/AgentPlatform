# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
# Retrieval runtime: sentence-transformers + baked embedding model.
# Default: CPU torch (CI / no-GPU). Local NVIDIA: pass TORCH_INDEX_URL
# (e.g. https://download.pytorch.org/whl/cu128 for RTX 50xx) via compose.
# BR3 (docs/38): model-baker + deps (pip/ST/models) then thin app stage.
# Changing app/** / system.md must not re-download torch or re-bake GTE.
# model-baker installs torch from offline torch_wheel_cache when present (same as deps);
# otherwise falls back to TORCH_FIND_LINKS (CPU). Final image keeps baked models only.
# Base digest pinned (deploy/base-images.env) so Hub tag moves do not bust deps.

ARG PYTHON_BASE=python:3.11-slim@sha256:a630a63cdb314e2d138a2fca3e375e319e8568346ffafac5b980f888630ac4f1
ARG EMBEDDING_MODEL=thenlper/gte-small
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ARG TORCH_FIND_LINKS=https://mirrors.aliyun.com/pytorch-wheels/cpu
ARG TORCH_INDEX_URL=
ARG HF_ENDPOINT=https://hf-mirror.com
ARG APT_MIRROR=mirrors.aliyun.com

FROM ${PYTHON_BASE} AS model-baker
ARG EMBEDDING_MODEL
ARG PIP_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG TORCH_FIND_LINKS
ARG HF_ENDPOINT
ARG APT_MIRROR
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_ENDPOINT=${HF_ENDPOINT} \
    HUGGINGFACE_HUB_ENDPOINT=${HF_ENDPOINT}

RUN set -eux; \
    if [ -n "${APT_MIRROR}" ]; then \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s/deb.debian.org/${APT_MIRROR}/g; s/security.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list.d/debian.sources; \
      elif [ -f /etc/apt/sources.list ]; then \
        sed -i "s/deb.debian.org/${APT_MIRROR}/g; s/security.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list; \
      fi; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends curl bubblewrap \
    && rm -rf /var/lib/apt/lists/*

# Prefer offline torch from named context `torch_wheel_cache` (same as deps) so
# cold builds after prune do not re-download ~192MB CPU torch from the mirror.
# Baker only needs torch to load/save ST weights; final image keeps models only.
RUN --mount=type=bind,from=torch_wheel_cache,target=/tmp/torch-wheels,ro \
    --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    if ls /tmp/torch-wheels/*.whl >/dev/null 2>&1; then \
      echo "model-baker: installing torch from offline wheel cache ($(ls /tmp/torch-wheels/*.whl | wc -l) files)"; \
      pip install --no-index --find-links=/tmp/torch-wheels torch; \
    else \
      echo "model-baker: no wheel cache → torch from ${TORCH_FIND_LINKS}"; \
      pip install torch -f "${TORCH_FIND_LINKS}"; \
    fi; \
    pip install "sentence-transformers>=3.0"
# Offline model seed via named build context `model_bake_cache` (compose
# additional_contexts) — not the main context, so multi-GB trees are not
# transferred on every build. Content changes do not bust this layer — bump
# EMBEDDING_MODEL or RUNTIME_REBUILD_DEPS=1 to re-bake.
RUN --mount=type=bind,from=model_bake_cache,target=/models-bake-cache,ro \
    set -eux; \
    cache_name="models--$(echo "${EMBEDDING_MODEL}" | sed 's|/|--|g')"; \
    mkdir -p /models-baked; \
    if [ -d "/models-bake-cache/${cache_name}" ]; then \
      echo "model-baker: seeding ${cache_name} from deploy/model-bake-cache (offline)"; \
      cp -a "/models-bake-cache/${cache_name}" /models-baked/; \
      if [ -f /models-bake-cache/CACHEDIR.TAG ]; then cp -a /models-bake-cache/CACHEDIR.TAG /models-baked/; fi; \
    else \
      echo "model-baker: cache miss for ${cache_name} → download ${EMBEDDING_MODEL} via ${HF_ENDPOINT}"; \
      python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('${EMBEDDING_MODEL}', cache_folder='/models-baked')"; \
    fi; \
    printf '%s\n' "${EMBEDDING_MODEL}" > /models-baked/.baked_embedding_model

FROM ${PYTHON_BASE} AS deps
ARG PIP_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG TORCH_FIND_LINKS
ARG TORCH_INDEX_URL
ARG APT_MIRROR
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN set -eux; \
    if [ -n "${APT_MIRROR}" ]; then \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s/deb.debian.org/${APT_MIRROR}/g; s/security.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list.d/debian.sources; \
      elif [ -f /etc/apt/sources.list ]; then \
        sed -i "s/deb.debian.org/${APT_MIRROR}/g; s/security.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list; \
      fi; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends curl bubblewrap \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 app
RUN mkdir -p /data/vectorstore /data/models /app/models-baked \
    && chown -R app:app /data /app/models-baked
WORKDIR /app

COPY packages/contracts/python/pyproject.toml /tmp/contracts/pyproject.toml
COPY services/runtime/pyproject.toml /tmp/runtime/pyproject.toml
# Offline CUDA wheels via named context `torch_wheel_cache` (not main context).
# Falls back to TORCH_INDEX_URL / CPU find-links when the cache has no .whl files.
# BuildKit pip cache mount: if deps layer is GC'd and re-RUN, wheels stay local (no mirror re-fetch).
# Do not use pip --no-cache-dir here — that bypasses the mount.
# Contracts *sources* are copied in the app stage so writing_prefs.py does not rebuild torch.
RUN --mount=type=bind,from=torch_wheel_cache,target=/tmp/torch-wheels,ro \
    --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /tmp/contracts/agent_contracts /tmp/runtime/app \
    && printf '%s\n' '# deps-layer stub' > /tmp/contracts/agent_contracts/__init__.py \
    && printf '%s\n' '# deps-layer stub' > /tmp/runtime/app/__init__.py \
    && if ls /tmp/torch-wheels/*.whl >/dev/null 2>&1; then \
         echo "deps: installing torch from offline wheel cache ($(ls /tmp/torch-wheels/*.whl | wc -l) files)"; \
         pip install --no-index --find-links=/tmp/torch-wheels torch; \
       elif [ -n "${TORCH_INDEX_URL}" ]; then \
         echo "deps: installing CUDA torch from ${TORCH_INDEX_URL}"; \
         pip install --default-timeout=300 --retries=5 torch --index-url "${TORCH_INDEX_URL}"; \
       else \
         echo "deps: installing CPU torch from ${TORCH_FIND_LINKS}"; \
         pip install --default-timeout=300 --retries=5 torch -f "${TORCH_FIND_LINKS}"; \
       fi \
    && pip install /tmp/contracts \
    && pip install "/tmp/runtime[retrieval,structural]" \
    && rm -rf /tmp/runtime /tmp/contracts

# Bake tree-sitter grammars at build time (no runtime GitHub download / GIL hang).
# Prefer offline seed from named context `ts_grammar_cache`; else prefetch().
COPY services/runtime/scripts/bake_ts_grammars.py /tmp/bake_ts_grammars.py
RUN --mount=type=bind,from=ts_grammar_cache,target=/tmp/ts-grammar-seed,ro \
    mkdir -p /home/app/.cache \
    && chown -R app:app /home/app \
    && su -s /bin/bash app -c 'HOME=/home/app TS_GRAMMAR_SEED_DIR=/tmp/ts-grammar-seed python -u /tmp/bake_ts_grammars.py' \
    && rm -f /tmp/bake_ts_grammars.py

COPY --from=model-baker --chown=app:app /models-baked /app/models-baked

# After pip/ST/models so adding CLI does not invalidate torch. ops-eval mounts the sock.
RUN apt-get update && apt-get install -y --no-install-recommends docker-cli ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && docker --version

FROM deps AS app
ARG EMBEDDING_MODEL
# Real contracts overlay the deps stub via PYTHONPATH (no pip / apt on code edits).
# docker-cli lives in deps so ops-eval sock mounts still work without re-apt.
ENV PYTHONPATH=/contracts/python
COPY services/runtime/app /app/app
COPY packages/contracts/python /contracts/python
COPY packages/contracts/schemas/events/payloads /app/contracts/events/payloads
COPY packages/contracts/validate_payload.py /app/packages/contracts/validate_payload.py
COPY packages/contracts/plan_suggest /app/packages/contracts/plan_suggest
COPY eval/recordings /app/eval/recordings
COPY --chmod=755 services/runtime/docker-entrypoint.sh /app/docker-entrypoint.sh
USER app
ENV EMBEDDING_MODEL=${EMBEDDING_MODEL}
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -f http://127.0.0.1:8001/health/live || exit 1
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
