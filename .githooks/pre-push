#!/usr/bin/env bash
# Blocks push when local CI proof fails (same class as GitHub Actions ``ci``).
# Default: scripts/preflight_ci.sh ≡ ci_proof (unit+gate) + web/codegen.
# Bypass: SKIP_PREFLIGHT=1 git push   OR   git push --no-verify
# Fast unit-only: PREFLIGHT_UNIT_ONLY=1 git push
set -euo pipefail

# Prefer git toplevel: BASH_SOURCE follows the .git/hooks symlink and would
# wrongly resolve ROOT to .git/ (looking for .git/scripts/...).
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
  hook="${BASH_SOURCE[0]}"
  if [[ -L "$hook" ]]; then
    hook="$(readlink -f "$hook" 2>/dev/null || readlink "$hook")"
  fi
  ROOT="$(cd "$(dirname "$hook")/.." && pwd)"
fi

# Only guard pushes that update branch tips (ignore tag-only / delete).
guard=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  # delete
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  guard=1
done

if [[ "$guard" -eq 0 ]]; then
  exit 0
fi

echo "==> git pre-push: running scripts/preflight_ci.sh"
exec bash "$ROOT/scripts/preflight_ci.sh"
