#!/usr/bin/env bash
# Blocks push when local CI unit suites fail (same class of failures as debug.log).
# Bypass: SKIP_PREFLIGHT=1 git push   OR   git push --no-verify
set -euo pipefail

# Prefer git toplevel: BASH_SOURCE follows the .git/hooks symlink and would
# wrongly resolve ROOT to .git/ (looking for .git/scripts/preflight_unit.sh).
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
  hook="${BASH_SOURCE[0]}"
  if [[ -L "$hook" ]]; then
    hook="$(readlink -f "$hook" 2>/dev/null || readlink "$hook")"
  fi
  ROOT="$(cd "$(dirname "$hook")/.." && pwd)"
fi

# Only guard pushes that update branch tips (ignore tag-only / delete).
guard=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  # delete
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  guard=1
done

if [[ "$guard" -eq 0 ]]; then
  exit 0
fi

echo "==> git pre-push: running scripts/preflight_unit.sh"
exec bash "$ROOT/scripts/preflight_unit.sh"
