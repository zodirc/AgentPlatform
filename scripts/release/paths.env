# Module → path prefixes (repo-relative). Format: MODULE=prefix1|prefix2|...
# Contracts: only paths COPY'd into the image. SemVer (`python/pyproject.toml`)
# and CHANGELOG do not dirty api/runtime. Pip-layer pin: python/pyproject.deps.toml.
#
# official_bench is bind-mounted at /repo for Ops L1 (git_diff / materialize / CSI
# probes). It must dirty api — otherwise the board can say「已是最新」while the
# long-lived uvicorn still runs a stale sys.modules copy of those scripts.
#
# deploy/base-images.env: pinned PYTHON/NODE/NGINX digests. Bumping it must dirty
# image-backed modules so `make up` rebuilds (ARG change invalidates deps layers).
# File unchanged → no rebuild; check cost is only path matching.

MODULE_api="services/api/|packages/contracts/python/agent_contracts/|packages/contracts/python/pyproject.deps.toml|packages/contracts/schemas/ddl/|scripts/official_bench/|deploy/base-images.env"
MODULE_runtime="services/runtime/|packages/contracts/python/agent_contracts/|packages/contracts/python/pyproject.deps.toml|packages/contracts/schemas/events/payloads/|packages/contracts/validate_payload.py|packages/contracts/plan_suggest/|deploy/base-images.env"
# A6: separate agent-ast-indexer process (same runtime image; own container health).
MODULE_ast_indexer="services/runtime/app/structural/workspace_index/|deploy/docker-compose.yml|deploy/base-images.env"
MODULE_web="services/web/|packages/contracts/plan_suggest/|deploy/base-images.env"
MODULE_gateway="deploy/caddy/|deploy/docker-compose.yml|deploy/compose/"

# make targets for image-backed services (gateway is compose recreate only).
MAKE_TARGET_api=up-api
MAKE_TARGET_runtime=up-runtime
MAKE_TARGET_ast_indexer=up-ast-indexer
MAKE_TARGET_web=up-web
