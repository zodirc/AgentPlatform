# Module → path prefixes (repo-relative). Format: MODULE=prefix1|prefix2|...
# Contracts: only paths COPY'd into the image. SemVer (`python/pyproject.toml`)
# and CHANGELOG do not dirty api/runtime. Pip-layer pin: python/pyproject.deps.toml.
#
# official_bench is bind-mounted at /repo for Ops L1 (git_diff / materialize / CSI
# probes). It must dirty api — otherwise the board can say「已是最新」while the
# long-lived uvicorn still runs a stale sys.modules copy of those scripts.
#
# deploy/base-images.env: pinned PYTHON/NODE/NGINX digests. Bumping it must dirty
# image-backed modules so `make up` rebuilds (ARG change invalidates deps layers).
# File unchanged → no rebuild; check cost is only path matching.
#
# ADR-020: sources_retrieval / model_gateway / sandbox are separate deploy modules
# (same runtime image, distinct containers). Embedding changes dirty sources_retrieval.
# Path matching uses longest MODULE_* prefix (ties share); so gateway_service.py
# owns model_gateway, while deploy/compose/planes.yml dirties every plane module.

MODULE_api="services/api/|packages/contracts/python/agent_contracts/|packages/contracts/python/pyproject.deps.toml|packages/contracts/schemas/ddl/|scripts/official_bench/|deploy/base-images.env"
MODULE_runtime="services/runtime/app/controller/|services/runtime/app/engine/|services/runtime/app/context/|services/runtime/app/tools/|services/runtime/app/writing/|services/runtime/app/scenarios/|services/runtime/app/model/|services/runtime/app/main.py|services/runtime/app/settings.py|services/runtime/pyproject.toml|services/runtime/Dockerfile|services/runtime/Dockerfile.retrieval|packages/contracts/python/agent_contracts/|packages/contracts/python/pyproject.deps.toml|packages/contracts/schemas/events/payloads/|packages/contracts/validate_payload.py|packages/contracts/plan_suggest/|deploy/base-images.env|deploy/compose/planes.yml"
# Exclude gateway_service.py from orchestrator-only model/ — it is model_gateway module.
MODULE_sources_retrieval="services/runtime/app/retrieval/|services/runtime/app/platform_bus/|services/sources-retrieval/|deploy/compose/planes.yml|deploy/compose/gpu.auto.yml|scripts/resolve_embedding_profile.sh|deploy/embedding.defaults.env|deploy/base-images.env|services/runtime/Dockerfile.retrieval|services/runtime/pyproject.toml"
MODULE_model_gateway="services/runtime/app/model/gateway_service.py|services/model-gateway/|services/runtime/Dockerfile|deploy/compose/planes.yml|deploy/base-images.env"
MODULE_sandbox="services/runtime/app/sandbox_plane/|services/sandbox/|services/runtime/Dockerfile|deploy/compose/planes.yml|deploy/base-images.env"
# A6: separate agent-ast-indexer process (same runtime image; own container health).
MODULE_ast_indexer="services/runtime/app/structural/workspace_index/|deploy/docker-compose.yml|deploy/compose/planes.yml|deploy/base-images.env"
MODULE_web="services/web/|packages/contracts/plan_suggest/|deploy/base-images.env"
MODULE_gateway="deploy/caddy/|deploy/docker-compose.yml|deploy/compose/"

# make targets for image-backed services (gateway is compose recreate only).
MAKE_TARGET_api=up-api
MAKE_TARGET_runtime=up-runtime
MAKE_TARGET_sources_retrieval=up-sources-retrieval
MAKE_TARGET_model_gateway=up-model-gateway
MAKE_TARGET_sandbox=up-sandbox
MAKE_TARGET_ast_indexer=up-ast-indexer
MAKE_TARGET_web=up-web
